# Phase 0-2 need NO credentials. The read-only interlock in polypaper/safety.py
# refuses to start if any signing key is present in the environment.
#
# Research (Phase 4) will need an LLM key. Nothing else.
# ANTHROPIC_API_KEY=

# Already-available SMTP config, wired in behind notify(event) later.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_TO=

# Reporting timezone. Storage is always UTC.
REPORT_TIMEZONE=America/Mexico_City
